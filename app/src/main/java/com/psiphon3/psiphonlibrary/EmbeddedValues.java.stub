    public static String SPONSOR_ID = "DaggomoVPN";

    // NOTE: Info link may be opened when not tunneled
    public static String INFO_LINK_URL = "https://daggomo.com/info";


    // To be shown to the user in the feedback page.
    public static String GET_NEW_VERSION_URL = "https://daggomo.com/download";
    public static String GET_NEW_VERSION_EMAIL = "get@daggomo.com";
